# ==========================================================
# KURUKSHETRA - Git Ignore
# ==========================================================

# ---------- Python ----------
.venv/
venv/
ENV/
env/

__pycache__/
*.py[cod]
*$py.class

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- VS Code ----------
.vscode/
.history/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
logs/
*.log

# ---------- Temporary ----------
temp/
tmp/
cache/
*.tmp

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- RAG / Vector Databases ----------
# Root-anchored (leading /): these are generated cache directories at the
# repo root, not source code. (A bare `embeddings/` here previously also
# matched kurukshetra/embeddings/, a real source directory 8 call sites
# depend on — root-anchoring this batch keeps that from happening again to
# anything else.)
/vector_store/
/embeddings/
/chroma_db/
/qdrant_storage/
/faiss_index/
/llama_index_storage/

# kurukshetra/embeddings/ (BGEEmbedding) — local build-only, not pushed to
# the shared repo by request. Note: this means kurukshetra/retrieval and
# kurukshetra/agent will not import on a fresh checkout without it present
# locally — add it back manually if you need to run/test those modules.
kurukshetra/embeddings/

# ---------- Parsed / Generated Knowledge ----------
extracted_text/
parsed_docs/
ocr_output/

# ---------- Generated Reports ----------
generated/
exports/
reports/

# ---------- Model Files ----------
models/
*.gguf
*.bin

# ---------- Archives ----------
*.zip
*.7z
*.rar

# ---------- Roo Local Cache ----------
.roo/cache/

# ==========================================================
# KEEP SOURCE KNOWLEDGE
# ==========================================================
!KNOWLEDGE/**/*.pdf
!KNOWLEDGE/**/*.docx
!KNOWLEDGE/**/*.xlsx
!KNOWLEDGE/**/*.pptx
!KNOWLEDGE/**/*.csv
!KNOWLEDGE/**/*.md

# Kurukshetra generated database
*.duckdb
*.wal
*.db

# Python cache
__pycache__/
*.pyc

# HuggingFace cache
models/
# Local enterprise share inventories
ina6fs01_inventory.csv
ina6fs01_folder_access.csv
knowledge/inbox/uploads/
